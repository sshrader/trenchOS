# Copy to .env.local for local development. On Railway, set these in the service's Variables tab.
# Never commit real keys.

# Solana RPC data (https://www.helius.dev). Without it the app falls back to the public RPC, which is heavily rate limited.
HELIUS_API_KEY=

# Used only to turn computed facts into a plain-English explanation. Without it, scans still work but skip the AI summary.
ANTHROPIC_API_KEY=
# Optional model override
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional invite gate for testing. If set, requests must send this code.
ACCESS_CODE=

# Requests per minute per IP for the scan endpoint
RATE_LIMIT_PER_MIN=10
