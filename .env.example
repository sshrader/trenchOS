# Copy to .env.local for local development. On Railway, set these in the service's Variables tab.
# Never commit real keys.

# Solana RPC data (https://www.helius.dev). Set just the key, not the full URL.
# Without it the app falls back to the public RPC, which is heavily rate limited.
HELIUS_API_KEY=

# AI explanation (optional). If no provider is configured, or every model fails,
# the app uses a plain-code summary, so scans always work.
# Provider is chosen automatically: OpenRouter if its key is set, else Anthropic.
# LLM_PROVIDER=openrouter

# OpenRouter (https://openrouter.ai). LLM_MODEL is a comma-separated list tried in order.
# Check each model id on openrouter.ai: free models are rate limited and come and go.
OPENROUTER_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free,inclusionai/ling-3.2-flash:free,thinkingmachines/inkling-2-small:free

# Anthropic (alternative). With this provider the first LLM_MODEL entry is used,
# or claude-sonnet-5-5 if LLM_MODEL is empty.
# ANTHROPIC_API_KEY=

# Optional invite gate for testing. If set, requests must send this code.
ACCESS_CODE=

# Requests per minute per IP for the scan endpoint
RATE_LIMIT_PER_MIN=10
